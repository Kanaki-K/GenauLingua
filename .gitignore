!example.env

# Local word datasets
Wordsbase/
app/scripts/*.xlsx

# Исключения: документация остаётся в Git
!diagnostics/README.md
!diagnostics/.gitkeep

# Scripts (diagnostics, broadcasts, one-time utilities)
app/scripts/*
!app/scripts/README.md
!app/scripts/rebuild_words_from_excel.py
# Эксплуатационные скрипты: нужны на сервере, а не разовые утилиты.
# rebuild_word_groups обязателен после любого изменения словарной базы.
!app/scripts/rebuild_word_groups.py
!app/scripts/audit_wordbase.py
!app/scripts/retranslate_wordbase.py
!app/scripts/smoke_quiz.py
!app/scripts/audit_admin.py
!app/scripts/load_prod_copy.py
!app/scripts/verify_quiz_chain.py
!app/scripts/verify_all_flows.py
!app/scripts/tts_samples.py
!app/scripts/tts_probe_telegram.py
!app/scripts/tts_benchmark.py
!app/scripts/tts_demo_card.py
!app/scripts/tts_preflight.py
!app/scripts/tts_verify_card.py
!app/scripts/tts_asr_check.py
!app/scripts/example_quality.py
!app/scripts/tts_pregenerate.py
!app/scripts/tts_synthesize.py
!app/scripts/wordbase_sample_review.py
!app/scripts/fix_examples.py
!app/scripts/review_proposals.py
!app/scripts/fix_lemmas.py
!app/scripts/fix_parallel_examples.py
!app/scripts/apply_lemma_overrides.py
!app/scripts/fix_levels.py
# Повторяются после каждого прогона переводов, а не разово:
# турецкую İ прогон ломает систематически, а дефекты примеров приходят из
# двух источников, пересечение которых мало
!app/scripts/fix_turkish_i.py
!app/scripts/merge_defects.py
# Нужен всякий раз, когда пакет прерван: отменённый пакет не значит пустой
!app/scripts/collect_batch.py
# Сторож пакетов: опрашивает и забирает сам. Жил в временной папке, которую
# система может вычистить — тогда пакеты истекли бы вместе с оплатой
!app/scripts/watch_batches.py
# Перед переносом озвучки на прод: правка текста оставляет прежний клип на
# диске, и сироты поехали бы по сети впустую
!app/scripts/tts_prune_orphans.py
# Исполняет последовательность из DEPLOY.md, чтобы документ и дело не разошлись
!app/scripts/finish_translation_round.py
# Проверяет предложения ДО применения и бесплатно: инструкции в запросе
# недостаточно, про турецкую İ там было сказано и всё равно вышло 429 строк
!app/scripts/validate_translations.py
# Апостроф повторится при каждом прогоне украинских переводов: правило
# зависит от твёрдости согласного, и модель его теряет
!app/scripts/fix_uk_apostrophe.py
# Пример-перевод не соответствует немецкому примеру. Отсев по слову это
# пропускает: слово в примере есть, а предложение другое
!app/scripts/example_person_mismatch.py
# Число в примере и переводе расходится — прямая порча знаний: «um 19 Uhr»
# против «o siódmej» учит неверному времени
!app/scripts/example_number_mismatch.py
!app/scripts/tts_trim_store.py
!app/scripts/tts_audit_clips.py

# Образцы и хранилище озвучки: аудио в репозитории не нужно.
# tts/ — это гигабайты синтезированных клипов, переносятся
# копированием каталога, а не через git.
tts_samples/
tts/

# One-time scripts
send_active.py
db_dump.sql
